[
  {
    "name": "Ignored tests",
    "matchedStatuses": ["skipped"]
  },
  {
    "name": "Infrastructure problems",
    "matchedStatuses": ["broken", "failed"],
    "messageRegex": ".*selenium.*|.*driver.*|.*timeout.*|.*connection.*"
  },
  {
    "name": "Outdated tests",
    "matchedStatuses": ["broken"],
    "traceRegex": ".*NoSuchMethodError.*"
  },
  {
    "name": "Application defects",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*AssertionError.*|.*assertion.*"
  },
  {
    "name": "Test execution problems", 
    "matchedStatuses": ["broken", "failed"],
    "messageRegex": ".*RuntimeException.*|.*Exception.*"
  }
]
